---
import type { Role } from '../data/profile';

interface Props {
  items: Role[];
  /** Show bullet points under each role. */
  detailed?: boolean;
}
const { items, detailed = false } = Astro.props;
---

<ol class="flex flex-col gap-8">
  {
    items.map((r, i) => (
      <li data-reveal style={`--i: ${i}`} class="grid gap-1 sm:grid-cols-[10.5rem_1fr] sm:gap-6">
        <p class="text-sm tabular-nums text-muted sm:pt-0.5">{r.period}</p>
        <div>
          <h3 class="font-condensed text-lg font-[650] text-ink">{r.title}</h3>
          <p class="text-muted">
            {r.org}
            {detailed && r.detail && <span>, {r.detail}</span>}
          </p>
          {detailed && <p class="text-sm text-muted">{r.place}</p>}
          {detailed && r.points.length > 0 && (
            <ul class="mt-3 flex max-w-prose list-disc flex-col gap-2 pl-5 text-ink/85 marker:text-muted">
              {r.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
