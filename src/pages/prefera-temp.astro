          <p class="section-desc" style="margin-bottom: 0;">Explore completed projects across Greater Jakarta, ranging from high-end residences to boutique retail environments and bespoke joinery.</p>
        </div>

        <!-- Filter Buttons with Entry Counts -->
        <div class="filter-nav">
          <button class="filter-btn active" data-filter="all">
            All Works
          </button>
          <button class="filter-btn" data-filter="Residential">
            Residential
          </button>
          <button class="filter-btn" data-filter="Commercial & Retail">
