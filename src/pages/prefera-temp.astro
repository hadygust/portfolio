  <!-- About & Philosophy (Light Linen Ivory Section) -->
  <section id="about" class="about-section">
    <div class="container">
      <div class="about-grid">
        <!-- Visual Composition -->
        <div class="about-images-composition">
          <div class="about-img-main">
            <img src="/prefera-temp/assets/projects/post_006_20260429_061759_DXtIoOzgQlp/image_01.jpg" alt="Prefera Studio Architectural Detail" />
          </div>
          <div class="about-quote-card">
            <blockquote>
              "Good interior architecture does not simply decorate walls; it choreographs light, honors material authenticity, and brings a profound sense of calm to everyday rituals."
            </blockquote>
            <div class="quote-author">Richard Saimin</div>
            <div class="quote-role">Principal & Interior Consultant, Prefera Design Studio</div>
          </div>
        </div>

        <!-- Narrative Content -->
        <div class="about-content">
          <span class="section-label" style="color: var(--color-gold-dark);">Philosophy & Vision</span>
          <h2 class="section-heading" style="color: var(--color-slate-900);">Designing Spaces That Breathe With Timeless Purpose.</h2>
          <p class="section-desc">
            Established in 2016 in North Jakarta, <strong>Prefera Design Studio</strong> has built a reputation for crafting discerning residential sanctuaries and elevated commercial environments across Indonesia.
          </p>
          <p class="section-desc">
            We believe that a space should evoke emotional resonance. Our process begins with deep spatial analysis, ensuring that proportion, acoustics, natural lighting, and tactile surfaces harmonize seamlessly.
          </p>

          <div class="pillars-grid">
            <div class="pillar-item">
              <span class="pillar-num">01</span>
              <div class="pillar-text">
                <h4>Spatial Narrative</h4>
                <p>Tailoring every layout to the client's distinct lifestyle, enhancing fluid transitions between private retreat and social gathering.</p>
              </div>
            </div>
            <div class="pillar-item">
              <span class="pillar-num">02</span>
              <div class="pillar-text">
                <h4>Material Integrity</h4>
                <p>Curating honest stones, European white oak, warm linen, textured plasters, and brushed brass that age gracefully over decades.</p>
              </div>
            </div>
            <div class="pillar-item">
              <span class="pillar-num">03</span>
              <div class="pillar-text">
                <h4>Artisan Execution</h4>
                <p>Partnering with premier builders and millwork artisans (such as Palais Construction and Spero Interior) to guarantee millimeter precision.</p>
              </div>
            </div>
          </div>
