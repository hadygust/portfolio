---
// Prefera Design Studio - Showcase Mockup
// Route: /prefera-temp
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Prefera Design Studio — Interior & Architectural Consultant</title>
  <meta name="description" content="Jakarta-based interior & architectural consultancy led by Richard Saimin. Designing bespoke residential sanctuaries, retail spaces, and commercial environments." />
  <link rel="stylesheet" href="/prefera-temp/css/style.css" />
  <!-- Font Awesome for clean modern icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>

  <!-- Top Studio Location Bar -->
  <div class="top-notice-bar">
    <span>Interior Architecture & Spatial Design • Jakarta Utara • Est. 2016</span>
  </div>

  <!-- Sticky Architectural Header -->
  <header class="site-header">
    <div class="container nav-wrap">
      <!-- Brand Logo (Fixed Outlined 'r' with Crisp Thin Stroke) -->
      <a href="#hero" class="brand-logo" aria-label="Prefera Design Studio Home">
        <span class="logo-prefera">p<span class="logo-r">r</span>efera</span>
        <span class="logo-subtitle">design studio</span>
      </a>

      <!-- Desktop Nav -->
      <nav aria-label="Main Navigation">
        <ul class="nav-menu">
          <li><a href="#projects" class="nav-link">Selected Works</a></li>
          <li><a href="#about" class="nav-link">Philosophy</a></li>
          <li><a href="#services" class="nav-link">Services</a></li>
          <li><a href="#process" class="nav-link">Process</a></li>
          <li><a href="#contact" class="nav-link">Contact & Location</a></li>
        </ul>
      </nav>

      <!-- Nav CTA with Direct WhatsApp link -->
      <div class="nav-actions">
        <a href="https://wa.me/6287880933820?text=Hello%20Prefera%20Design%20Studio,%20I%20would%20like%20to%20consult%20about%20a%20project." 
           target="_blank" 
           rel="noopener" 
           class="btn btn-whatsapp">
          <i class="fa-brands fa-whatsapp"></i> Chat WhatsApp
        </a>
        <button class="mobile-toggle" aria-label="Open Mobile Menu">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section id="hero" class="hero-section">
    <!-- Dynamic Background Image Carousel (from Scraped Assets) -->
    <div class="hero-bg-slider">
      <div class="hero-slide active" style="background-image: url('/prefera-temp/assets/projects/post_002_20260610_063549_DZZUDmMgQek/image_01.jpg');"></div>
      <div class="hero-slide" style="background-image: url('/prefera-temp/assets/projects/post_007_20260414_043654_DXGVIy3AQGL/image_01.jpg');"></div>
      <div class="hero-slide" style="background-image: url('/prefera-temp/assets/projects/post_001_20260724_101401_DbLAANngWfz/image_01.jpg');"></div>
      <div class="hero-slide" style="background-image: url('/prefera-temp/assets/projects/post_019_20250614_065134_DK3y5JDTjp_/image_01.jpg');"></div>
    </div>
    <div class="hero-overlay"></div>

    <div class="container hero-content">
      <span class="hero-tagline">Interior & Architectural Consultancy</span>
      <h1 class="hero-title">
        Harmonizing <em>Space</em>, Texture & Natural <em>Light</em>.
      </h1>
      <p class="hero-description">
        Prefera Design Studio transforms residential architectures and commercial spaces into refined, sensorial environments. Led by Richard Saimin, we craft spaces tailored to modern rituals and enduring beauty.
      </p>

      <div class="hero-actions">
        <a href="#projects" class="btn btn-gold">
          Explore Portfolio <i class="fa-solid fa-arrow-right-long"></i>
        </a>
        <a href="https://wa.me/6287880933820?text=Hello%20Prefera%20Design%20Studio,%20I%20would%20like%20to%20consult%20about%20a%20project." 
           target="_blank" 
           rel="noopener" 
           class="btn btn-outline">
          <i class="fa-brands fa-whatsapp"></i> Quick Consultation
        </a>
      </div>

      <!-- Studio Stats -->
      <div class="hero-stats">
        <div class="stat-item">
          <div class="stat-num">2016</div>
          <div class="stat-label">Studio Founded</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">100+</div>
          <div class="stat-label">Spaces Realized</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">Bespoke</div>
          <div class="stat-label">Architectural Detail</div>
        </div>
      </div>
    </div>
  </section>

