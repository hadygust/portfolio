---
// Hero "ID tag": headshot at badge scale, current roles, and a tear-off contact stub.
import { Image } from 'astro:assets';
import portrait from '../assets/profile.jpg';
import { site } from '../data/site';

const fields = [
  { label: 'Now', value: 'Senior IT Developer, MDS Retailing (Matahari)' },
  { label: 'Also', value: 'Freelance engineer, Karana OS' },
  { label: 'Education', value: 'Computer Science, BINUS University (GPA 3.82)' },
];
const contacts = [
  { label: 'Email', href: `mailto:${site.email}`, external: false },
  ...site.socials.map((s) => ({ label: s.label, href: s.href, external: true })),
];
---

<div class="relative rounded-label border border-line bg-surface shadow-label">
  <span aria-hidden="true" class="absolute top-4 right-4 size-3 rounded-full border border-line bg-kraft"></span>
  <div class="flex items-center gap-4 p-5 pb-4">
    <span class="shrink-0 rounded-control bg-kraft-soft p-1">
      <Image
        src={portrait}
        alt={`Headshot of ${site.name}`}
        widths={[88, 176]}
        sizes="88px"
        loading="eager"
        class="block size-[5.5rem] rounded-[0.375rem] object-cover"
      />
    </span>
    <div class="min-w-0">
      <p class="font-condensed text-xl leading-tight font-[650] text-ink">{site.name}</p>
      <p class="mt-1 text-sm text-muted">{site.role}</p>
    </div>
  </div>
  <dl class="mx-5 border-t border-line">
    {
      fields.map((f) => (
        <div class="grid grid-cols-[5.5rem_1fr] gap-3 border-b border-line py-2.5 last:border-b-0">
          <dt class="field-label pt-0.5">{f.label}</dt>
          <dd class="text-sm text-ink">{f.value}</dd>
        </div>
      ))
    }
  </dl>
  <ul aria-label="Contact" class="mt-4 grid grid-cols-3 border-t border-dashed border-line text-sm">
    {
      contacts.map((c, i) => (
        <li class:list={[i > 0 && 'border-l border-dashed border-line']}>
          <a
            href={c.href}
            rel={c.external ? 'noopener noreferrer' : undefined}
            class="flex min-h-12 items-center justify-center font-medium text-accent transition-colors hover:bg-kraft-soft hover:text-accent-hover"
          >
            {c.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>
