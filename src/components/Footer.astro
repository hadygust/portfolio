---
import ResumeLink from './ResumeLink.astro';
import { site } from '../data/site';
---

<footer class="mt-24 border-t border-line">
  <div class="wrap flex flex-col gap-6 py-10 text-sm text-muted sm:flex-row sm:items-start sm:justify-between">
    <p>&copy; {new Date().getFullYear()} {site.name}</p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {site.nav.map((item) => <li><a href={item.href} class="hover:text-ink">{item.label}</a></li>)}
        {site.resume && <li><ResumeLink variant="text">Resume</ResumeLink></li>}
        <li><a href={`mailto:${site.email}`} class="hover:text-ink">Email</a></li>
        {
          site.socials.map((s) => (
            <li>
              <a href={s.href} rel="noopener noreferrer" class="hover:text-ink">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
